<Window x:Class="ShoesApp.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы — ООО «Обувь»"
        Width="1100" Height="650"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/icon.ico"
        Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Image Source="Resources/logo.png" Width="50" Height="50" Stretch="Uniform"/>
            <TextBlock Text="Заказы" FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1" Name="dgOrders" AutoGenerateColumns="True"
                  IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" HeadersVisibility="Column"
                  FontFamily="Times New Roman" FontSize="13" RowHeight="26"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Добавить"      Style="{StaticResource AccentButton}"    Name="btnAdd"    Click="BtnAdd_Click"/>
            <Button Content="Редактировать" Style="{StaticResource SecondaryButton}" Name="btnEdit"   Click="BtnEdit_Click"/>
            <Button Content="Удалить"       Style="{StaticResource SecondaryButton}" Name="btnDelete" Click="BtnDelete_Click"/>
            <Button Content="Назад"         Style="{StaticResource SecondaryButton}" Name="btnBack"   Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Window>