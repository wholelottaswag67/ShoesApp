<Window x:Class="ShoesApp.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ" Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        Icon="Resources/icon.ico"
        Background="White">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Артикулы (через ,):"/>
        <TextBox Grid.Row="0" Grid.Column="1" Name="txtArticles"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Дата заказа:"/>
        <DatePicker Grid.Row="1" Grid.Column="1" Name="dpOrderDate" Margin="4"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Дата доставки:"/>
        <DatePicker Grid.Row="2" Grid.Column="1" Name="dpDeliveryDate" Margin="4"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Пункт выдачи:"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Name="cmbPickup"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Клиент:"/>
        <TextBox Grid.Row="4" Grid.Column="1" Name="txtClient"/>

        <Label Grid.Row="5" Grid.Column="0" Content="Код получения:"/>
        <TextBox Grid.Row="5" Grid.Column="1" Name="txtCode"/>

        <Label Grid.Row="6" Grid.Column="0" Content="Статус:"/>
        <ComboBox Grid.Row="6" Grid.Column="1" Name="cmbStatus"/>

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Style="{StaticResource AccentButton}" Width="140"
                    Click="BtnOk_Click"/>
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="100"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>