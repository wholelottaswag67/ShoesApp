<Window x:Class="ShoesApp.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Width="480" Height="620"
        WindowStartupLocation="CenterOwner"
        Icon="Resources/icon.ico"
        Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0"  Grid.Column="0" Content="Артикул:"/>
            <TextBox Grid.Row="0" Grid.Column="1" Name="txtArticle"/>

            <Label Grid.Row="1"  Grid.Column="0" Content="Наименование:"/>
            <TextBox Grid.Row="1" Grid.Column="1" Name="txtName"/>

            <Label Grid.Row="2"  Grid.Column="0" Content="Ед. изм.:"/>
            <TextBox Grid.Row="2" Grid.Column="1" Name="txtUnit" Text="шт."/>

            <Label Grid.Row="3"  Grid.Column="0" Content="Цена:"/>
            <TextBox Grid.Row="3" Grid.Column="1" Name="txtPrice"/>

            <Label Grid.Row="4"  Grid.Column="0" Content="Поставщик:"/>
            <TextBox Grid.Row="4" Grid.Column="1" Name="txtSupplier"/>

            <Label Grid.Row="5"  Grid.Column="0" Content="Производитель:"/>
            <TextBox Grid.Row="5" Grid.Column="1" Name="txtManufacturer"/>

            <Label Grid.Row="6"  Grid.Column="0" Content="Категория:"/>
            <ComboBox Grid.Row="6" Grid.Column="1" Name="cmbCategory"/>

            <Label Grid.Row="7"  Grid.Column="0" Content="Скидка %:"/>
            <TextBox Grid.Row="7" Grid.Column="1" Name="txtDiscount"/>

            <Label Grid.Row="8"  Grid.Column="0" Content="Кол-во на складе:"/>
            <TextBox Grid.Row="8" Grid.Column="1" Name="txtStock"/>

            <Label Grid.Row="9"  Grid.Column="0" Content="Описание:"/>
            <TextBox Grid.Row="9" Grid.Column="1" Name="txtDescription" Height="80"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>

            <Label Grid.Row="10" Grid.Column="0" Content="Фото (имя файла):"/>
            <TextBox Grid.Row="10" Grid.Column="1" Name="txtPhoto"/>

            <StackPanel Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Сохранить" Style="{StaticResource AccentButton}" Width="140"
                        Click="BtnOk_Click"/>
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="100"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>