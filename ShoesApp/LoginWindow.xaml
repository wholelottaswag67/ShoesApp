<Window x:Class="ShoesApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — ООО «Обувь»"
        Width="560" Height="420"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/icon.ico"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="58.256"/>
            <RowDefinition Height="41.744"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Логотип + заголовок -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="0" Margin="0,0,0,20" Grid.RowSpan="2">
            <Image Source="/Icon.png" Stretch="Fill" Height="54" Width="60"/>
            <Image Source="Resources/logo.png" Width="80" Height="80" Stretch="Uniform"/>
            <TextBlock Text="ООО «Обувь»" FontSize="26" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <!-- Поля -->
        <Grid Grid.Row="2" Width="380" Margin="70,0,70,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Логин:"/>
            <TextBox Grid.Row="0" Grid.Column="1" Name="txtLogin"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Пароль:"/>
            <PasswordBox Grid.Row="1" Grid.Column="1" Name="txtPass"/>
        </Grid>

        <!-- Ошибка -->
        <TextBlock Grid.Row="3" Name="lblError" Foreground="Red"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Войти" Style="{StaticResource AccentButton}"
                    Width="160" Name="btnLogin" Click="BtnLogin_Click"/>
            <Button Content="Войти как гость" Style="{StaticResource SecondaryButton}"
                    Width="180" Name="btnGuest" Click="BtnGuest_Click"/>
        </StackPanel>
    </Grid>
</Window>