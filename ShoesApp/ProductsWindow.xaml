<Window x:Class="ShoesApp.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товары — ООО «Обувь»"
        Width="1150" Height="680"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/icon.ico"
        Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок + логотип + роль -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Image Source="Resources/logo.png" Width="50" Height="50" Stretch="Uniform"/>
            <TextBlock Text="Список товаров" FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="10,0,20,0"/>
            <TextBlock Name="lblRole" VerticalAlignment="Center" Foreground="Gray"/>
        </StackPanel>

        <!-- Панель фильтров -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Name="txtSearch" Width="280" TextChanged="Filter_Changed"/>
            <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="10,0,4,0"/>
            <ComboBox Name="cmbFilter" Width="170" SelectionChanged="Filter_Changed"/>
            <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="10,0,4,0"/>
            <ComboBox Name="cmbSort" Width="160" SelectionChanged="Filter_Changed"/>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid Grid.Row="2" Name="dgProducts"
          IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" 
          HeadersVisibility="Column" FontFamily="Times New Roman" FontSize="13"
          RowHeight="60" LoadingRow="dgProducts_LoadingRow" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="80"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="120"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="80"/>
                <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="100"/>
                <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="100"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="110"/>
                <DataGridTextColumn Header="Скидка %" Binding="{Binding Discount}" Width="70"/>
                <DataGridTextColumn Header="На складе" Binding="{Binding Stock}" Width="80"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>

                <!-- ВОТ ЗДЕСЬ МАГИЯ: Колонка с картинкой -->
                <DataGridTemplateColumn Header="Фото" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Биндим путь к картинке. Если файла нет, покажется пустое место -->
                            <Image Source="{Binding PhotoPath}" Width="50" Height="50" Stretch="Uniform"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Добавить"      Style="{StaticResource AccentButton}"    Name="btnAdd"    Click="BtnAdd_Click"/>
            <Button Content="Редактировать" Style="{StaticResource SecondaryButton}" Name="btnEdit"   Click="BtnEdit_Click"/>
            <Button Content="Удалить"       Style="{StaticResource SecondaryButton}" Name="btnDelete" Click="BtnDelete_Click"/>
            <Button Content="Заказы"        Style="{StaticResource SecondaryButton}" Name="btnOrders" Click="BtnOrders_Click"/>
            <Button Content="Выход"         Style="{StaticResource SecondaryButton}" Name="btnExit"   Click="BtnExit_Click"/>
        </StackPanel>
    </Grid>
</Window>